    {
      "dot": "cyan",
      "title": "Why the orchestrator retrieves",
      "items": [
        "The Verifier is handed sources and judges only those",
        "A model that cannot search cannot invent a citation",
        "No sources short-circuits to unverifiable before any model call"
      ]
    },
    {
      "dot": "amber",
      "title": "The one agent that searches",
      "items": [
        "Fandom asks what this audience has already litigated",
        "That is iterative, so it holds Parallel's MCP tools",
        "Trusted with what has been argued about, never with what is true"
      ]
    },
    {
      "dot": "rose",
      "title": "Thirty seconds, streamed",
      "items": [
        "Each agent reports start, duration and finding over SSE",
        "Claims are checked concurrently, capped at six",
        "The wait is the evidence the system is multi-step"
      ]
