  "cards": [
    {
      "dot": "cyan",
      "title": "Why Cloud Run, not Agent Engine",
      "items": [
        "min-instances 0 idles at about zero",
        "The URL has to survive nine weeks of judging on a small credit",
        "max-instances 3 caps what a public URL can spend"
      ]
    },
    {
      "dot": "amber",
      "title": "Nothing secret is in the image",
      "items": [
        "Secret Manager injects the key at start, never baked in",
        "Vertex authenticates through the metadata server",
        "The runtime account holds WRITER on one dataset and nothing else"
      ]
    },
    {
      "dot": "rose",
      "title": "One route to the open web",
      "items": [
        "Parallel is the only external egress in the service",
        "The Search API is called by the pipeline, per claim",
        "The MCP server is handed to exactly one agent"
      ]
    }
  ]
