  "cards": [
    {
      "dot": "cyan",
      "title": "Why agents have no tools",
      "items": [
        "Retrieval lives in Python, so a citation cannot be hallucinated",
        "The sequence is control flow, not a model choosing a next step",
        "No sources short-circuits to unverifiable before any model call"
      ]
    },
    {
      "dot": "amber",
      "title": "Two questions, not one",
      "items": [
        "Verifier asks whether the claim is true",
        "Fandom asks what this audience has already litigated",
        "Rights asks whether using it needs permission"
      ]
    },
    {
      "dot": "rose",
      "title": "The guarantee is code",
      "items": [
        "route() decides escalation as a pure, tested function",
        "Contested always reaches a human, in both production modes",
        "The model never rules on which side of a dispute is right"
      ]
    },
    {
      "dot": "violet",
      "title": "Where a graph earns its place",
      "items": [
        "A rewrite used to be accepted if it was merely non-empty",
        "Routing is a plain function, not a model \u2014 ADR 002 restated",
        "It cannot search: a model must not verify its own homework"
      ]
    }
  ]
